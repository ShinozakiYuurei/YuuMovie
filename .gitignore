# ── 依赖与构建产物 ──────────────────────────────────
node_modules/
.next/
out/
dist/
*.tsbuildinfo
next-env.d.ts

# ── 抓取数据：由服务器每 2 小时生成，绝不进仓库 ──────
data/

# ── 本地化海报：由 scripts/fetch-posters.mjs 生成 ────
# 为什么排除：361 张 WebP 约 11MB，且能从 data/movies.json 的 URL 全量重建
# （文件名就是原始 URL 的 sha1 前 16 位，可自愈反推）。
# 服务器上由 rebuild-static.sh 每次重建时增量生成，不进仓库。
# 保留目录本身：next build 只会把存在的 public/ 子目录拷进 out/，
# 目录不存在时 out/posters/ 不会生成，同源海报会 404。
public/posters/*
!public/posters/.gitkeep

# ── 服务器私有：密钥、缓存、备份 ────────────────────
# .ssh/ 必须排除：hkmovie 的 HOME 就是本目录，
# 只读部署私钥落在仓库内，一旦被 git add -A 扫到就泄进版本库。
.ssh/
.backup/
.local/
.config/
.npm/
.env*.local
*.log

# ── 本地性能测量临时目录 ────────────────────────────
.perf/

# ── 本机杂项：临时进度文件与本地测试数据 ─────────────
# data.local-test/ 是本地跑的抓取样本（结构同 data/，但不是线上数据），
# 不入库以免被误当成真实数据源；.claude-tmp-progress.md 是会话临时文件。
# 两者若不排除，deploy/sync.sh 的 `git add -A` 会把它们一起提交上去。
.claude-tmp-progress.md
data.local-test/

# ── probe/：默认全不入库，只点名收回归探针 ────────────
# 入库标准：不联网、只依赖仓库内代码与 data/，因为**部署链路会真的执行它们**。
#   - check-danger.mts 由 deploy/sync.sh 在本地自检阶段跑（挡错合并）
#   - check-genres.mts 由 deploy/sync.sh 在本地自检阶段跑（挡类型标签重复/简繁混用）
#   - check-poster-pick.mts 由 deploy/sync.sh 在本地自检阶段跑（挡选错海报）
#   - check-poster-color.mts 由 deploy/sync.sh 在本地自检阶段跑（挡主色取错：黑白片染色/亮色压字）
#   - check-contrast.mts 由 deploy/sync.sh 在本地自检阶段跑（挡文字对比度令牌被改坏）
#   - check-version-text.mts 由 deploy/sync.sh 在本地自检阶段跑（挡场次卡片版本·语言写错）
#   - check-cinema-specs.mts 由 deploy/sync.sh 在本地自检阶段跑（挡戲院影廳規格推断错）
#   - check-slug-coverage.mts 由 deploy/sync.sh 在本地自检阶段跑（挡卡片链接指向未生成的 movie 页）
#   - check-published-links.mjs 由 deploy/vps-deploy.sh 在服务器上跑（挡死链）
#   - check-nav-category.mjs 由 deploy/vps-deploy.sh 在服务器上跑
#     （挡详情页被归错类：待映片标成现正上映，面包屑与顶栏色块都错）
#     放在服务器而非本地自检：它要扫的是构建产物（HTML + 打包后的 CSS），
#     本机在 next build 之前没有 out/ 可扫。
#   - check-rating-badge.mjs 由 deploy/vps-deploy.sh 在服务器上跑
#     （挡详情页「級別」两种状态长得不一样：待映片的 TBC 曾是裸灰字，
#       与已定级那枚灰底药丸不同壳；顺带钉住 JSON-LD contentRating 与徽章同源）
#     同样必须扫产物，理由同上。
# 其余是抓包、逆向签名、基准测试等一次性调试现场（含 52MB HTML 转储），
# 留在本机不进仓库。
#
# 为什么不能写 `!probe/*.mjs` 这类通配白名单：tsconfig 把 probe/ 整个 exclude，
# tsc 不检查它们，通配白名单等于不设防（曾因此误收 74 个脚本）。
#
# 注意：gitignore 的 # 只在行首是注释，规则行不能加行尾说明，
# 否则整行变成一个永远匹配不上的模式（本文件曾因此白名单整体失效）。
probe/*
!probe/check-danger.mts
!probe/check-genres.mts
!probe/check-poster-pick.mts
!probe/check-poster-color.mts
!probe/check-contrast.mts
!probe/check-version-text.mts
!probe/check-cinema-specs.mts
!probe/check-slug-coverage.mts
!probe/check-published-links.mjs
!probe/check-nav-category.mjs
!probe/check-rating-badge.mjs
